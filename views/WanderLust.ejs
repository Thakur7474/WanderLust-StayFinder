<% layout("layouts/boilerplate") %>


  <title>WanderLust Private Limited | Travel made personal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <style>
    :root { --coral:#ff4f5e; --ink:#202124; --muted:#676d73; --cream:#fff8f4; --line:#e8e4e1; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; color:var(--ink); font-family:"DM Sans",sans-serif; background:#fff; }
    a { color:inherit; text-decoration:none; }
    .wrap { width:min(1180px, calc(100% - 48px)); margin:auto; }
    nav { height:76px; border-bottom:1px solid var(--line); display:flex; align-items:center; background:rgba(255,255,255,.95); position:sticky; top:0; z-index:10; backdrop-filter:blur(12px); }
    .nav-inner { display:flex; justify-content:space-between; align-items:center; width:100%; }
    .brand { display:flex; align-items:center; gap:9px; font-family:"Playfair Display",serif; font-weight:700; font-size:22px; letter-spacing:-.7px; }
    .mark { width:31px; height:31px; border-radius:11px 11px 11px 3px; transform:rotate(-25deg); display:grid; place-items:center; background:var(--coral); color:white; font-family:Arial,sans-serif; font-size:17px; }
    .brand em { color:var(--coral); font-style:normal; }
    .links { display:flex; gap:30px; font-size:14px; font-weight:600; }
    .links a:hover { color:var(--coral); }
    .nav-cta { border:1px solid #ddd; padding:10px 15px; border-radius:24px; font-weight:700; font-size:14px; box-shadow:0 2px 6px #0000000d; }
    .hero { min-height:590px; display:grid; place-items:center; position:relative; overflow:hidden; color:white; text-align:center; background:linear-gradient(90deg,rgba(16,23,29,.62),rgba(16,23,29,.20)),url('https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=2200&q=85') center/cover; }
    .hero::after { content:""; position:absolute; inset:auto -10% -1px; height:95px; background:white; border-radius:50% 50% 0 0 / 100% 100% 0 0; }
    .hero-content { position:relative; z-index:1; margin-top:-30px; max-width:780px; padding:40px 0; }
    .eyebrow { font-size:13px; font-weight:700; letter-spacing:1.7px; text-transform:uppercase; }
    h1 { font-family:"Playfair Display",serif; font-size:clamp(45px,7vw,82px); line-height:.99; letter-spacing:-3px; margin:18px 0 24px; }
    .hero p { margin:0 auto 31px; max-width:580px; font-size:18px; line-height:1.65; }
    .button { display:inline-block; color:white; background:var(--coral); padding:15px 23px; border-radius:28px; font-size:15px; font-weight:700; box-shadow:0 10px 25px #d73d4b70; }
    section { padding:90px 0; }
    .intro { display:grid; grid-template-columns:1.05fr .95fr; gap:90px; align-items:center; }
    .section-label { color:var(--coral); font-size:13px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; }
    h2 { font-family:"Playfair Display",serif; letter-spacing:-1.3px; font-size:43px; line-height:1.08; margin:14px 0 20px; }
    .copy { color:var(--muted); font-size:16px; line-height:1.75; }
    .facts { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .fact { padding:27px; min-height:142px; border:1px solid var(--line); border-radius:18px; background:#fff; }
    .fact b { display:block; font:600 32px "Playfair Display",serif; color:var(--coral); margin-bottom:7px; }
    .fact span { color:var(--muted); font-size:14px; line-height:1.35; }
    .values { background:var(--cream); }
    .section-head { max-width:620px; }
    .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:42px; }
    .card { background:white; padding:28px; border-radius:20px; border:1px solid #f0e9e5; }
    .icon { font-size:27px; width:50px; height:50px; display:grid; place-items:center; border-radius:15px; background:#fff1ee; }
    .card h3 { font-size:19px; margin:23px 0 10px; }
    .card p { color:var(--muted); line-height:1.6; font-size:15px; margin:0; }
    .impact { display:grid; grid-template-columns:.93fr 1.07fr; background:#263534; color:white; border-radius:25px; overflow:hidden; }
    .impact-image { min-height:410px; background:url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1300&q=85') center/cover; }
    .impact-copy { padding:66px; }
    .impact-copy h2 { margin-top:13px; }
    .impact-copy .copy { color:#dbe3df; }
    .impact-copy .section-label { color:#ffa5aa; }
    .steps { display:flex; gap:25px; margin-top:27px; }
    .steps b { display:block; color:#ff8b94; font-size:20px; }
    .steps span { display:block; margin-top:5px; font-size:13px; color:#dbe3df; }
    .legal { text-align:center; padding-top:20px; }
    .legal h2 { max-width:650px; margin-left:auto; margin-right:auto; }
    .legal-grid { display:grid; grid-template-columns:repeat(3,1fr); max-width:960px; margin:39px auto 0; border:1px solid var(--line); border-radius:18px; overflow:hidden; text-align:left; }
    .legal-grid div { padding:25px; border-right:1px solid var(--line); }
    .legal-grid div:last-child { border:0; }
    .legal-grid small { color:var(--muted); display:block; margin-bottom:7px; }
    .legal-grid strong { font-size:15px; }
    footer { border-top:1px solid var(--line); padding:30px 0; color:var(--muted); font-size:13px; }
    .footer-inner { display:flex; justify-content:space-between; gap:20px; }
    @media (max-width:760px) { .wrap { width:min(100% - 32px, 1180px); } .links { display:none; } .hero { min-height:560px; } .hero p { font-size:16px; } section { padding:64px 0; } .intro,.impact { grid-template-columns:1fr; gap:35px; } h2 { font-size:35px; } .facts,.cards { grid-template-columns:1fr; } .impact-image { min-height:250px; } .impact-copy { padding:38px 27px; } .legal-grid { grid-template-columns:1fr; } .legal-grid div { border-right:0; border-bottom:1px solid var(--line); } .footer-inner { display:block; } .footer-inner p:last-child { margin-top:12px; } }
  </style>

  <main id="top">
    <header class="hero"><div class="hero-content"><div class="eyebrow">WanderLust Private Limited</div><h1>Travel should feel like<br>coming alive.</h1><p>We help people discover stays and experiences that turn every journey into a story worth bringing home.</p><a class="button" href="#about">Discover our story →</a></div></header>
    <section id="about"><div class="wrap intro"><div><div class="section-label">Who we are</div><h2>Built for the curious, wherever they go.</h2><p class="copy">WanderLust Private Limited is a travel and hospitality platform created to make finding a place to stay feel personal, simple, and inspiring. We connect travellers with distinctive homes, hotels, and hosts—while helping local communities benefit from tourism.</p><p class="copy">From a spontaneous weekend escape to a longer stay in a new city, our aim is to make every guest feel less like a visitor and more like they belong.</p></div><div class="facts"><div class="fact"><b>One idea</b><span>Make meaningful travel easier for everyone.</span></div><div class="fact"><b>Many stays</b><span>From quiet homes to city hotels and unique escapes.</span></div><div class="fact"><b>People first</b><span>Designed around guests, hosts, and local communities.</span></div><div class="fact"><b>India based</b><span>Built with a deep love for local discovery.</span></div></div></div></section>
    <section class="values" id="values"><div class="wrap"><div class="section-head"><div class="section-label">What guides us</div><h2>A more human way to travel.</h2><p class="copy">We are building a marketplace where trust, belonging, and unforgettable local experiences come first.</p></div><div class="cards"><article class="card"><div class="icon">⌂</div><h3>Belong anywhere</h3><p>Every stay should offer comfort, warmth, and a genuine connection to its destination.</p></article><article class="card"><div class="icon">♡</div><h3>Travel with care</h3><p>We encourage thoughtful choices that respect people, places, and the environment.</p></article><article class="card"><div class="icon">✦</div><h3>Keep it real</h3><p>Clear information, honest reviews, and reliable support help every trip start with confidence.</p></article></div></div></section>
    <section id="impact"><div class="wrap"><div class="impact"><div class="impact-image" role="img" aria-label="Traveller overlooking a mountain valley"></div><div class="impact-copy"><div class="section-label">Our promise</div><h2>More discovery. More opportunity. More good journeys.</h2><p class="copy">When travellers choose WanderLust, they discover the character of a place. When hosts welcome them, they can share what makes that place special.</p><div class="steps"><div><b>01</b><span>Discover locally</span></div><div><b>02</b><span>Stay confidently</span></div><div><b>03</b><span>Leave inspired</span></div></div></div></div></div></section>
    <section class="legal" id="contact"><div class="wrap"><div class="section-label">Company information</div><h2>WanderLust Private Limited</h2><p class="copy">A private company focused on travel, stays, and hospitality experiences.</p><div class="legal-grid"><div><small>Business</small><strong>Travel &amp; Hospitality Platform</strong></div><div><small>Registered office</small><strong>Add your official office address</strong></div><div><small>Official contact</small><strong>Add your business email address</strong></div></div></div></section>
  </main>
